# Required: the Tablo account that owns the Gen 4 device.
TABLO_EMAIL=you@example.com
TABLO_PASSWORD=replace-me

# Instead of TABLO_PASSWORD, Docker secrets can be used:
# TABLO_PASSWORD_FILE=/run/secrets/tablo_password

# Required only when the account has more than one Tablo.
# TABLO_DEVICE_SID=SID_123456789ABC

# OTA channels are the reliable Plex path. Tablo FAST/OTT channels are off by default.
TABLOSYNC_INCLUDE_OTT=false

# Optional overrides.
TABLOSYNC_FRIENDLY_NAME=TabloSync
TABLOSYNC_PORT=5004
TABLOSYNC_CHANNEL_CACHE_SECONDS=3600
# TABLOSYNC_TUNER_COUNT=2
# TABLOSYNC_ADVERTISE_URL=http://192.168.1.20:5004

# Optional, separate BTN/Xfinity TV Everywhere tuner. No Xfinity password belongs here.
# Start with: docker compose up -d --build tablosync-tve
# Then open http://SERVER_LAN_IP:5005/auth/fox to authorize on FOX/Xfinity's own site.
# TABLOSYNC_TVE_PORT=5005
# TABLOSYNC_TVE_ADVERTISE_URL=http://192.168.1.20:5005
# TABLOSYNC_TVE_BTN_GUIDE_NUMBER=6100
# Optional local FOX Sports affiliate. Example: WYFX-LD in Youngstown.
# TABLOSYNC_TVE_FOX_CALL_SIGN=WYFX-LD
# TABLOSYNC_TVE_FOX_GUIDE_NUMBER=6101
# TABLOSYNC_TVE_FOX_NAME=Fox
# TABLOSYNC_TVE_AUTH_UI=true
